<Files ~ "^.*\.([Hh][Tt][Aa])">
Order Allow,Deny
Deny From All
Satisfy All
</Files>

<IfModule mod_headers.c>
  Header set X-UA-Compatible "IE=Edge"
  <FilesMatch "\.(appcache|crx|css|eot|gif|htc|ico|jpe?g|js|m4a|m4v|manifest|mp4|oex|oga|ogg|ogv|otf|pdf|png|safariextz|svg|svgz|ttf|vcf|webm|webp|woff|xml|xpi)$">
    Header unset X-UA-Compatible
  </FilesMatch>
</IfModule>

ErrorDocument 400 /erro
ErrorDocument 401 /erro
ErrorDocument 403 /erro
ErrorDocument 404 /erro
ErrorDocument 500 /erro

# Ative o HSTS (Strict-Transport-Security)
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

# X-Frame-Options
Header always set X-Frame-Options "SAMEORIGIN"

# X-Content-Type-Options
Header always set X-Content-Type-Options "nosniff"

# Referrer-Policy
Header always set Referrer-Policy "policy"

# Política de Permissões (CORS)
Header always set Access-Control-Allow-Origin "origin"
Header always set Permissions-Policy "geolocation=(); midi=();notifications=();push=();sync-xhr=();accelerometer=(); gyroscope=(); magnetometer=(); payment=(); camera=(); microphone=();usb=(); xr=();speaker=(self);vibrate=();fullscreen=(self);"  

<IfModule mod_rewrite.c>

RewriteEngine On

# Mesma árvore de URLs do clone estático: wp-content e wp-includes na raiz apontam para assets
RewriteRule ^wp-content/(.*)$ assets/brazilts/wp-content/$1 [L]
RewriteRule ^wp-includes/(.*)$ assets/brazilts/wp-includes/$1 [L]

RewriteRule ^informacoes\/([a-z,0-9,A-Z,_-]+)\/?$ pg-seo.php?url=$1 [NC,L]
RewriteRule ^busca\/?$ produtos.php [NC]

# SE A PÁGINA ESTIVER DENTRO DO SOURCE UTILIZAR ESSA OTIMIZAÇÃO DE URL
RewriteRule ^categoria\/([a-z,0-9,_-]+)\/([0-9-]+)\/([0-9-]+)?$ produtos.php?id=$2&father_id=$3 [NC,L]   
RewriteRule ^subcategoria\/([a-z,0-9,_-]+)\/([0-9-]+)\/([0-9-]+)?$ produtos.php?id=$2&father_id=$3 [NC,L]
RewriteRule ^produto\/([a-z,0-9,_-]+)\/([0-9-]+)\/([,|0-9-]+)?$ prod.php?id=$2&cat_id=$3 [NC,L]

# BrazilTS: /orcamento/ no site oficial = mesma página que contato (formulário externo)
RewriteRule ^orcamento/?$ contato.php [NC,L]

# BrazilTS: URLs amigáveis servicos/* → ficheiro .php na raiz (sem pastas)
RewriteRule ^servicos/traducao-juramentada/?$ servicos-traducao-juramentada.php [NC,L]
RewriteRule ^servicos/traducao-cientifica/?$ servicos-traducao-cientifica.php [NC,L]
RewriteRule ^servicos/traducao-em-libras/?$ servicos-traducao-em-libras.php [NC,L]
RewriteRule ^servicos/traducao-simultanea-consecutiva/?$ servicos-traducao-simultanea-consecutiva.php [NC,L]
RewriteRule ^servicos/transcricao-de-audio-e-video/?$ servicos-transcricao-de-audio-e-video.php [NC,L]
RewriteRule ^servicos/legendagem-de-video/?$ servicos-legendagem-de-video.php [NC,L]
RewriteRule ^servicos/locacao-de-equipamento/?$ servicos-locacao-de-equipamento.php [NC,L]
RewriteRule ^servicos/apostille-de-la-haye/?$ servicos-apostille-de-la-haye.php [NC,L]

RewriteRule ^([a-z,0-9,A-Z,_-]+)\/?$ $1.php [NC]